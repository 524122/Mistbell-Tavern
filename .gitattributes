# 统一文本文件行尾，避免跨平台差异
* text=auto eol=lf

# Windows 脚本保持 CRLF
*.bat text eol=crlf
gradlew.bat text eol=crlf

# Shell 脚本保持 LF
*.sh text eol=lf
gradlew text eol=lf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.db binary
*.jar binary
*.keystore binary
*.apk binary

# 语言统计：忽略生成物与脚本，聚焦源码
*.bat linguist-vendored
gradlew linguist-vendored
gradle/wrapper/* linguist-vendored
samples/* linguist-documentation
