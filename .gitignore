# 构建产物
.gradle/
.gradle-user-home/
.android-user-home/
build/
app/build/
captures/
.cxx/
*.apk
*.aab
*.hprof

# IDE / 本地配置
.idea/
*.iml
local.properties
.kotlin/

# 数据库文件(含真实用户数据与密钥,严禁上传)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# 密钥 / 签名(预防性)
*.keystore
*.jks
keystore.properties

# 系统 / 杂项
.DS_Store
*.log

# 发布说明文档不上传(beta 阶段)
RELEASE_NOTES_*.md
RELEASE_DESCRIPTION_*.md

# 本地产物副本（_research_* / .research_*）不入库
_research_*/
.research_*/
/app/debug/
.zcode/

# E2E 实测取证产物不入库（基建本身入库，用法见 .e2e/README.md）
.e2e/*.png
.e2e/ui.xml

# 实测截图留档不入库（设计文档引用的两张证据图除外）
screenshots/*
!screenshots/render-mvu-panel.png
!screenshots/render-narrative.png

# 示例主题包的打包产物与编辑器工具配置不入库
samples/*.zip
.cursor/

# Python 字节码缓存（评测夹具脚本运行时产生，见 .e2e/eval/memory/README.md）
__pycache__/
